<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        styleClass="screen-container"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ph.edu.dlsu.lbycpob.memorymatch.ui.LeaderboardController">

    <VBox
            alignment="CENTER"
            maxWidth="820"
            spacing="16"
            styleClass="content-card">

        <Label
                text="LEADERBOARD"
                styleClass="eyebrow-label"/>

        <Label
                text="Hall of Memory"
                styleClass="title-label"/>

        <Label
                fx:id="connectionLabel"
                text=""
                visible="false"
                managed="false"
                styleClass="hint-label"/>

        <ScrollPane
                fitToWidth="true"
                prefViewportHeight="430"
                styleClass="clean-scroll">

            <content>

                <VBox
                        fx:id="rowsContainer"
                        alignment="TOP_CENTER"
                        spacing="10"
                        style="-fx-padding: 8;"/>

            </content>

        </ScrollPane>

        <Button
                text="BACK TO MENU"
                styleClass="cartoon-button, ghost-button"
                onAction="#handleBack"/>

    </VBox>

</StackPane>