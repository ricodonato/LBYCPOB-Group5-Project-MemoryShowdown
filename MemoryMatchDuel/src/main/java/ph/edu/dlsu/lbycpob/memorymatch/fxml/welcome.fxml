<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        styleClass="screen-container"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ph.edu.dlsu.lbycpob.memorymatch.ui.WelcomeController">

    <VBox
            alignment="CENTER"
            maxWidth="720"
            spacing="18"
            styleClass="hero-card">

        <Label
                text="MEMORY MATCH"
                styleClass="eyebrow-label"/>

        <Label
                text="Showdown"
                styleClass="mega-title"/>

        <Label
                text="Flip cards. Build combos. Win the series."
                styleClass="subtitle-label"/>

        <Label
                text="🧠  🎴  ⚡  🏆"
                styleClass="hero-icons"/>

        <VBox
                alignment="CENTER"
                spacing="12"
                style="-fx-padding: 24 0 0 0;">

            <Button
                    text="PLAY A DUEL"
                    prefWidth="300"
                    styleClass="cartoon-button, primary-button"
                    onAction="#handlePlay"/>

            <Button
                    text="LEADERBOARD"
                    prefWidth="300"
                    styleClass="cartoon-button, blue-button"
                    onAction="#handleLeaderboard"/>

            <Button
                    text="TOURNAMENT MODE"
                    prefWidth="300"
                    styleClass="cartoon-button, purple-button"
                    onAction="#handleTournament"/>

        </VBox>

        <Label
                text="DLSU LBYCPOB • Group 5"
                styleClass="footer-label"/>

    </VBox>

</StackPane>