<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.FlowPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<BorderPane
styleClass="game-screen"
xmlns="http://javafx.com/javafx"
xmlns:fx="http://javafx.com/fxml"
fx:controller="ph.edu.dlsu.lbycpob.memorymatch.ui.GameBoardController">

    <top>

        <VBox
spacing="8"
styleClass="game-header">

            <HBox
alignment="CENTER"
spacing="16">

                <VBox
HBox.hgrow="ALWAYS"
alignment="CENTER_LEFT">

                    <Label
text="MEMORY MATCH SHOWDOWN"
styleClass="game-brand"/>

                    <Label
fx:id="matchRuleLabel"
styleClass="game-meta"/>

                </VBox>

                <Label
fx:id="roundLabel"
styleClass="round-badge"/>

                <Button
text="QUIT MATCH"
styleClass="mini-button, danger-button"
onAction="#handleQuitMatch"/>

            </HBox>

            <HBox
fx:id="scorePanelContainer"
alignment="CENTER"
spacing="18"/>

            <Label
fx:id="turnLabel"
styleClass="turn-banner"
maxWidth="1.7976931348623157E308"/>

        </VBox>

    </top>

    <center>

        <FlowPane
fx:id="cardGrid"
alignment="CENTER"
hgap="12"
vgap="12"
styleClass="card-grid"/>

    </center>

</BorderPane>