<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        styleClass="screen-container"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ph.edu.dlsu.lbycpob.memorymatch.ui.NameEntryController">

    <VBox
            alignment="CENTER"
            maxWidth="760"
            spacing="18"
            styleClass="content-card">

        <Label
                text="PLAYER SELECT"
                styleClass="eyebrow-label"/>

        <Label
                text="Who's entering the showdown?"
                styleClass="title-label"/>

        <Label
                text="Two players share one board and take turns after every missed pair."
                styleClass="subtitle-label"
                wrapText="true"/>

        <HBox
                alignment="CENTER"
                spacing="28"
                style="-fx-padding: 18 0 8 0;">

            <VBox
                    spacing="8"
                    alignment="CENTER_LEFT">

                <Label
                        text="PLAYER 1"
                        styleClass="field-label"/>

                <TextField
                        fx:id="player1Field"
                        promptText="Enter player 1 name"
                        prefWidth="270"
                        styleClass="cartoon-textfield"/>

            </VBox>

            <Label
                    text="VS"
                    styleClass="vs-badge"/>

            <VBox
                    spacing="8"
                    alignment="CENTER_LEFT">

                <Label
                        text="PLAYER 2"
                        styleClass="field-label"/>

                <TextField
                        fx:id="player2Field"
                        promptText="Enter player 2 name"
                        prefWidth="270"
                        styleClass="cartoon-textfield"/>

            </VBox>

        </HBox>

        <Label
                fx:id="errorLabel"
                text=""
                visible="false"
                managed="false"
                styleClass="error-label"/>

        <HBox
                alignment="CENTER"
                spacing="12"
                style="-fx-padding: 10 0 0 0;">

            <Button
                    text="BACK"
                    styleClass="cartoon-button, ghost-button"
                    onAction="#handleBack"/>

            <Button
                    text="CONTINUE"
                    styleClass="cartoon-button, green-button"
                    onAction="#handleNext"/>

        </HBox>

    </VBox>

</StackPane>